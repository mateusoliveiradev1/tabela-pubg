# Valores exclusivamente locais. Use um gerenciador de segredos em produção.
NODE_ENV=development
LOG_LEVEL=info

POSTGRES_DB=pubg_camp
POSTGRES_USER=pubg
POSTGRES_PASSWORD=pubg_local_only
DATABASE_URL=postgresql://pubg:pubg_local_only@postgres:5432/pubg_camp

REDIS_URL=redis://redis:6379

# Identidade e segurança (Fase 2). Gere valores reais no gerenciador de segredos.
APP_ORIGIN=http://localhost:3000
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/entrar/discord/retorno
DISCORD_PKCE_MODE=required
# Preencha somente para uma exceção PKCE documentada e aprovada.
DISCORD_PKCE_EXCEPTION_ID=

SESSION_COOKIE_NAME=__Host-session
SESSION_COOKIE_SECRET=
SESSION_COOKIE_SECURE=false
SESSION_IDLE_TTL_SECONDS=2592000
SESSION_ABSOLUTE_TTL_SECONDS=7776000
SESSION_ACTIVITY_WRITE_INTERVAL_SECONDS=300
CSRF_SECRET=

OTP_PEPPER=
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60

# Chave AES-256-GCM hexadecimal (32 bytes) e versão ativa.
AES_GCM_KEY_V1=
ENCRYPTION_KEY_VERSION=v1

RESEND_API_KEY=
EMAIL_FROM=
TRUSTED_PROXY=none

S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=pubg-camp
S3_ACCESS_KEY=pubg_local
S3_SECRET_KEY=pubg_local_only
NEXT_PUBLIC_ORGANIZATION_LOGO_ORIGINS=http://localhost:9000,http://127.0.0.1:9000
MINIO_ROOT_USER=pubg_local
MINIO_ROOT_PASSWORD=pubg_local_only

# Obrigatório apenas para iniciar o container do bot.
DISCORD_BOT_TOKEN=replace_with_a_development_bot_token
