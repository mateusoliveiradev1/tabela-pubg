{
  "name": "@pubg-camp/storage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external @aws-sdk/client-s3 --external @aws-sdk/s3-request-presigner",
    "clean": "rimraf dist coverage",
    "lint": "biome check src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1115.0",
    "@aws-sdk/s3-request-presigner": "3.1115.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
