{
  "name": "pubg-camp-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma modular para organizar e transmitir campeonatos comunitários de PUBG PC.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint && pnpm lint:boundaries",
    "lint:fix": "biome check --write .",
    "lint:boundaries": "depcruise --config .dependency-cruiser.cjs apps packages",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf .turbo coverage",
    "ci:verify": "pnpm verify:secrets && pnpm verify:migrations && pnpm verify:compose && pnpm verify:phase2-ci && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "env:up": "docker compose up --build -d",
    "env:down": "docker compose down",
    "env:logs": "docker compose logs -f",
    "verify:compose": "node scripts/verify-compose.mjs",
    "verify:migrations": "node scripts/check-migrations.mjs && pnpm --filter @pubg-camp/database db:check",
    "verify:phase2-ci": "node scripts/validate-phase2-ci.mjs .github/workflows/ci.yml",
    "verify:secrets": "node scripts/check-secrets.mjs",
    "phase2:integration:preflight": "node scripts/run-phase2-integration.mjs --preflight-only",
    "phase2:redis-integration": "pnpm phase2:integration:preflight && pnpm --filter @pubg-camp/api exec vitest run --config vitest.redis-integration.config.ts",
    "phase2:integration": "node scripts/run-phase2-integration.mjs --suite integration",
    "phase2:concurrent": "node scripts/run-phase2-integration.mjs --suite concurrent",
    "test:e2e:runtime": "pnpm --filter @pubg-camp/web test:e2e:runtime"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/node": "26.2.0",
    "dependency-cruiser": "18.2.0",
    "rimraf": "6.1.2",
    "tsup": "8.5.1",
    "tsx": "4.23.12",
    "turbo": "2.10.11",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
